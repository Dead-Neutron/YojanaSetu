# ==============================================================================
# YojanaSetu Environment Variables Template
# Copy this file to .env and fill in your actual credentials before running.
# Never commit .env to version control!
# ==============================================================================

# Tiger Data PostgreSQL Database Connection (pgvector enabled)
# Example: postgresql://username:password@hostname:5432/yojanasetu?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/yojanasetu"

# Google Cloud Vertex AI / Gemini Flash API Key
GOOGLE_API_KEY="your-google-api-key-here"

# ElevenLabs Multilingual Voice Streaming
ELEVENLABS_API_KEY="your-elevenlabs-api-key-here"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM" # e.g. Rachel or a selected multilingual Indian voice model

# Auth0 Authentication & User Profiles
AUTH0_DOMAIN="your-tenant.auth0.com"
AUTH0_CLIENT_ID="your-auth0-client-id"
AUTH0_CLIENT_SECRET="your-auth0-client-secret"
AUTH0_AUDIENCE="https://yojanasetu-api.local"
AUTH0_ISSUER_BASE_URL="https://your-tenant.auth0.com"

# Backend Server Configuration
PORT=8000
HOST="127.0.0.1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
RATE_LIMIT_PER_MINUTE=60

# Frontend Next.js Public Environment
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
