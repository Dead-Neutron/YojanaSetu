# YojanaSetu Frontend Environment Configuration

# Backend API Endpoint
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Auth0 Authentication (Optional - All features are 100% accessible to guests without login)
NEXT_PUBLIC_AUTH0_DOMAIN="dev-yojanasetu.us.auth0.com"
NEXT_PUBLIC_AUTH0_CLIENT_ID="your_auth0_client_id"
NEXT_PUBLIC_AUTH0_AUDIENCE="https://yojanasetu-api.local"
NEXT_PUBLIC_AUTH0_REDIRECT_URI="http://localhost:3000"
